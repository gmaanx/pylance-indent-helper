{
  "name": "pylance-indent-helper",
  "displayName": "Trợ lý bài tập Python",
  "description": "Giải bài tập Python và chèn kết quả vào file đang soạn.",
  "version": "1.6.4",
  "publisher": "ms-python-tools",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Education"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pylanceIndentHelper.instantFormat",
        "title": "Giải bài offline",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.deepFormat",
        "title": "Phân tích bài offline",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.ghostMode",
        "title": "Gửi yêu cầu đến Cloud",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.silentFix",
        "title": "Kiểm tra và sửa Python offline",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.localAi",
        "title": "Phân tích với Ollama",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.runSavedFile",
        "title": "Chạy file đã lưu bằng Python của công cụ",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.showPythonRuntime",
        "title": "Xem môi trường Python của công cụ",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.uninstallAll",
        "title": "Gỡ phần cơ bản",
        "category": "Bài tập Python"
      },
      {
        "command": "pylanceIndentHelper.cancelGhost",
        "title": "Hủy yêu cầu đang chạy",
        "category": "Bài tập Python",
        "enablement": "pylanceIndentHelper.running"
      },
      {
        "command": "pylanceIndentHelper.forgetSessionKeys",
        "title": "Quên API key phiên này",
        "category": "Bài tập Python"
      }
    ],
    "keybindings": [
      {
        "command": "pylanceIndentHelper.instantFormat",
        "key": "alt+1",
        "when": "editorTextFocus && editorLangId == python && !editorReadonly && !inDiffEditor"
      },
      {
        "command": "pylanceIndentHelper.deepFormat",
        "key": "alt+2",
        "when": "editorTextFocus && editorLangId == python && !editorReadonly && !inDiffEditor"
      },
      {
        "command": "pylanceIndentHelper.ghostMode",
        "key": "alt+3",
        "when": "editorTextFocus && editorLangId == python && !editorReadonly && !inDiffEditor"
      },
      {
        "command": "pylanceIndentHelper.silentFix",
        "key": "alt+4",
        "when": "editorTextFocus && editorLangId == python && !editorReadonly && !inDiffEditor"
      },
      {
        "command": "pylanceIndentHelper.localAi",
        "key": "alt+5",
        "when": "editorTextFocus && editorLangId == python && !editorReadonly && !inDiffEditor"
      },
      {
        "command": "pylanceIndentHelper.uninstallAll",
        "key": "alt+0",
        "when": "editorTextFocus && editorLangId == python && !inDiffEditor"
      },
      {
        "command": "pylanceIndentHelper.cancelGhost",
        "key": "escape",
        "when": "editorTextFocus && editorLangId == python && pylanceIndentHelper.running"
      }
    ]
  }
}
